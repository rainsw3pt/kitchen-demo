/* Базовые цвета — легко поменять в одном месте */
:root {
  --header-bg: #3a3f4e;          /* тёмно‑серый фон шапки */
  --text-main: #f5f6fa;          /* светлый текст для контраста */
  --text-muted: #bcc2cc;         /* приглушённый серый для неактивных пунктов */
  --accent-orange: #ff8c00;      /* тёплый оранжевый акцент */
  --accent-hover: #e67e00;       /* чуть темнее при наведении */
}

.header {
  background-color: var(--header-bg);
  padding: 0;
  margin: 0;
}

.header__container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

.header__inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 70px; /* фиксированная высота шапки */
}

/* Логотип */
.logo {
  font-family: "Inter", "Roboto", sans-serif;
  font-weight: 700;
  font-size: 24px;
  color: var(--text-main);
  text-decoration: none;
  letter-spacing: -0.5px;
}

.logo span {
  color: var(--accent-orange); /* оранжевая часть KitchenStudio */
}

/* Навигация */
.nav {
  display: flex;
  gap: 32px;
  list-style: none; /* если nav — ul, иначе убери */
}

.nav a {
  text-decoration: none;
  color: var(--text-muted);
  font-family: "Inter", "Roboto", sans-serif;
  font-weight: 500;
  font-size: 16px;
  transition: color 0.3s ease, text-shadow 0.3s ease;
}

.nav a:hover,
.nav a.active {
  color: var(--text-main);
  text-shadow: 0 0 8px rgba(255, 140, 0, 0.4); /* лёгкое свечение оранжевого */
}

/* Адаптив: на мобильных меню можно сделать бургер или просто уменьшить отступы */
@media (max-width: 768px) {
  .header__inner {
    flex-direction: column;
    height: auto;
    padding: 16px 0;
  }

  .nav {
    margin-top: 16px;
    gap: 20px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .logo {
    font-size: 20px;
  }
}

